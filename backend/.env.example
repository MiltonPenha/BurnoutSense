NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://burnoutsense:burnoutsense@localhost:5432/burnoutsense?schema=public"
FRONTEND_URL="http://localhost:3000"
JWT_ACCESS_SECRET="change-this-access-secret"
# Required in production: generate an independent random secret of at least 32 characters.
CSRF_SECRET=""
# Render terminates TLS at its proxy. Confirm the proxy topology before changing this.
TRUST_PROXY_HOPS=1
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_API_KEY=""
ESBEU_ASSESSMENTS_ENABLED=true
DAILY_CONTEXT_EVOLUTION_ENABLED=false
GEMINI_GUIDANCE_ENABLED=false
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
# Hostinger Mail defaults. Confirm the SMTP server in the mailbox panel.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="lembrete@burnoutsense.online"
SMTP_PASS=""
SMTP_FROM="BurnoutSense <lembrete@burnoutsense.online>"
DAILY_REMINDER_ENABLED=false
DAILY_REMINDER_HOUR=12
DAILY_REMINDER_MINUTE=0
DAILY_REMINDER_TIMEZONE="America/Sao_Paulo"
