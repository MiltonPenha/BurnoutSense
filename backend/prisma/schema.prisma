generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum PredictionSource {
  MODEL
  MODEL_WITH_PREVENTIVE_CALIBRATION
  BACKEND_FALLBACK
  FRONTEND_LOCAL
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  passwordHash  String
  role          UserRole      @default(STUDENT)
  emailAlerts   Boolean       @default(true)
  dailyReminder Boolean       @default(true)
  course        String?
  semester      String?
  avatarUrl     String?
  assessments   Assessment[]
  esbeuAssessments EsbeuAssessment[]
  dailyCheckIns DailyCheckIn[]
  reminderDeliveries DailyReminderDelivery[]
  sessions      AuthSession[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  revokedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Assessment {
  id                         String            @id @default(uuid())
  userId                     String
  user                       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                       DateTime          @default(now())
  studyHours                 Float
  sleepHours                 Float             @default(7)
  workHours                  Float             @default(0)
  pendingTasks               Int               @default(0)
  hasImportantExamOrDelivery Boolean           @default(false)
  sleepQuality               Int
  stressLevel                Int
  tirednessLevel             Int               @default(5)
  anxietyLevel               Int
  academicPerformance        Int
  examPressure               Int               @default(5)
  screenTime                 Float
  socialSupport              Int
  financialStress            Int
  physicalActivity           Int
  motivationLevel            Int
  mood                       String?
  dailyDescription           String?
  result                     PredictionResult?
  createdAt                  DateTime          @default(now())

  @@index([userId])
  @@map("assessments")
}

model PredictionResult {
  id               String           @id @default(uuid())
  assessmentId     String           @unique
  assessment       Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  riskLevel        RiskLevel
  confidence       Float
  riskScore        Float?
  mainFactors      Json
  modelVersion     String
  predictionSource PredictionSource @default(MODEL)
  createdAt        DateTime         @default(now())

  @@map("prediction_results")
}

// Separate from historical classification; no research CSV is imported here.
model EsbeuAssessment {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  context            Json
  source             String   @default("context")
  evolution          Json?
  dailyBaseline      Json?
  dailyEvidenceSince DateTime?
  observedItems      Json?
  estimatedOverall   Float
  observedOverall    Float?
  observedExhaustion Float?
  observedDistancing Float?
  observedInefficacy Float?
  modelName          String
  modelVersion       String
  datasetVersion     String
  contractVersion    String
  formVersion        String
  consentVersion     String
  consentAcceptedAt  DateTime
  adultConfirmed     Boolean
  enrolledConfirmed  Boolean
  createdAt          DateTime @default(now())
  dailyCheckIns      DailyCheckIn[] @relation("CheckInContext")
  triggerCheckInId   String?
  triggerCheckIn     DailyCheckIn? @relation("CheckInTrigger", fields: [triggerCheckInId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([triggerCheckInId])
  @@map("esbeu_assessments")
}

model DailyCheckIn {
  id                  String @id @default(uuid())
  userId              String
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime @db.Date
  mood                String
  sleepHours          Float
  energy              Int?
  academicDemand      Int?
  observations        Json?
  note                String @default("")
  contextAssessmentId String?
  contextAssessment   EsbeuAssessment? @relation("CheckInContext", fields: [contextAssessmentId], references: [id], onDelete: SetNull)
  triggeredAssessments EsbeuAssessment[] @relation("CheckInTrigger")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  indexProcessedRevision DateTime?

  @@unique([userId, date])
  @@index([userId, date, id])
  @@map("daily_check_ins")
}

model DailyReminderDelivery {
  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  claimedAt     DateTime?
  sentAt        DateTime?
  nextAttemptAt DateTime?
  attempts      Int @default(0)

  @@id([userId, date])
  @@map("daily_reminder_deliveries")
}
